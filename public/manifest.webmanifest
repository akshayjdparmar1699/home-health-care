{
    "name": "Yours Home Healthcare",
    "short_name": "Yours Home",
    "description": "Yours Home Healthcare: staff duty, shifts and billing",
    "id": "/",
    "start_url": "/?source=pwa",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "portrait",
    "background_color": "#f8fafc",
