{
    "name": "Yours Home Admin",
    "short_name": "YH Admin",
    "description": "Yours Home Healthcare: owner panel for staff, clients, attendance and billing",
    "id": "/admin",
    "start_url": "/admin?source=pwa",
    "scope": "/admin",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "portrait",
    "background_color": "#f8fafc",
    "theme_color": "#24366d",
    "lang": "en-IN",
    "categories": ["medical", "business", "productivity"],
    "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Attendance", "short_name": "Attendance", "url": "/admin/attendance", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Assignments", "short_name": "Assignments", "url": "/admin/assignments", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
